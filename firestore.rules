rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Global security helpers
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Bootstrapped admin verification
    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email == 'ti1590091@gmail.com')
      );
    }

    // Validation for User Profile
    function isValidUserProfile(data) {
      return data.uid is string && data.uid.size() <= 128 &&
             data.email is string && data.email.size() <= 256 &&
             data.companyName is string && data.companyName.size() <= 200 &&
             data.contactPerson is string && data.contactPerson.size() <= 150 &&
             data.status in ['pending', 'approved', 'rejected', 'suspended'] &&
             data.role in ['admin', 'seller', 'buyer', 'logistics', 'pending'];
    }

    // Validation for Account Request
    function isValidAccountRequest(data) {
      return data.requestId is string && data.requestId.size() <= 128 &&
             data.uid is string && data.uid.size() <= 128 &&
             data.companyName is string && data.companyName.size() <= 200 &&
             data.contactPerson is string && data.contactPerson.size() <= 150 &&
             data.email is string && data.email.size() <= 256 &&
             data.requestedAccountType in ['seller', 'buyer', 'logistics'] &&
             data.status in ['pending', 'approved', 'rejected', 'suspended'];
    }

    // 1. Users collection
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin() || isSignedIn();

      // One-click Google sign-in setup allows users to initialize their profile
      allow create: if isValidId(userId) &&
                       isSignedIn() &&
                       isValidUserProfile(incoming()) &&
                       (
                         (isOwner(userId) && incoming().uid == request.auth.uid) ||
                         isAdmin() ||
                         (request.auth.token.email == 'ti1590091@gmail.com')
                       );

      allow update: if isValidId(userId) &&
                       isSignedIn() &&
                       isValidUserProfile(incoming()) &&
                       (
                         isAdmin() ||
                         (
                           isOwner(userId) &&
                           incoming().uid == existing().uid &&
                           incoming().email == existing().email
                         )
                       );

      allow delete: if isValidId(userId) && isAdmin();
    }

    // 2. Account Registration Requests collection
    match /accountRequests/{requestId} {
      allow get, list: if isSignedIn();

      allow create: if isValidId(requestId) &&
                       isSignedIn() &&
                       isValidAccountRequest(incoming()) &&
                       incoming().uid == request.auth.uid;

      allow update: if isValidId(requestId) &&
                       (isAdmin() || (isSignedIn() && incoming().uid == request.auth.uid));

      allow delete: if isValidId(requestId) && isAdmin();
    }

    // 3. Trusted Administrators collection
    match /admins/{adminId} {
      allow get, list: if isSignedIn();

      allow create: if isValidId(adminId) && (
        isAdmin() ||
        (isSignedIn() && request.auth.token.email == 'ti1590091@gmail.com' && request.auth.uid == adminId)
      );

      allow update, delete: if isValidId(adminId) && isAdmin();
    }

    // 4. B2B Orders collection
    match /orders/{orderId} {
      allow get, list: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(orderId);
      allow delete: if isAdmin() && isValidId(orderId);
    }

    // 5. Quotations collection
    match /quotations/{quotationId} {
      allow get, list: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(quotationId);
      allow delete: if isAdmin() && isValidId(quotationId);
    }

    // 6. Buyers (Inquiries / Leads) collection
    match /buyers/{buyerId} {
      allow get, list: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(buyerId);
      allow delete: if isAdmin() && isValidId(buyerId);
    }

    // 7. Products catalog collection (publicly readable for sourcing)
    match /products/{productId} {
      allow get, list: if true;
      allow create, update, delete: if isSignedIn() && isValidId(productId);
    }
  }
}
